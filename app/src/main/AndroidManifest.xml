<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />

    <application
        android:label="Horizon"
        android:hasCode="true"
        android:allowBackup="false">

        <!-- Menu: its own process, so a game crash leaves it alive to show the logs. -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The built-in Pumpkin server (see ServerService). A foreground service: Android keeps it while the game runs. -->
        <service android:name=".ServerService" android:exported="false" />

        <!-- Hand tracking check: camera picture with the found hands, status, camera and rotation choice. -->
        <activity
            android:name=".HandTestActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />

        <!-- VR menu: a stereo, lens-distorted menu for a phone in a viewer. A second icon, "Horizon VR", opens it directly
             (a gamepad or the hands drive it). Same process as the launcher: it only starts the game, it does not run it. -->
        <activity
            android:name=".VrMenuActivity"
            android:label="Horizon VR"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|uiMode|density|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Control layout editor: runs in the menu process, saves plain Mojo JSON that the game reads. -->
        <activity
            android:name=".LayoutEditorActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|uiMode|density|navigation" />

        <!-- The game itself, in a separate process: killed on exit (android_main runs once per process). -->
        <activity
            android:name=".HorizonActivity"
            android:exported="false"
            android:process=":game"
            android:windowSoftInputMode="adjustNothing|stateHidden"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|uiMode|density|navigation">
            <meta-data android:name="android.app.lib_name" android:value="horizon_client" />
        </activity>
    </application>
</manifest>
